{
  "name": "react-gantt",
  "version": "3.0.0",
  "description": "Gantt chart react component",
  "homepage": "https://gitlab.com/bitspur/misc/react-gantt",
  "bugs": {
    "url": "https://gitlab.com/bitspur/misc/react-gantt/-/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Clay Risser",
    "email": "clayrisser@gmail.com",
    "url": "https://clayrisser.com"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/bitspur/misc/react-gantt"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "build:demo": "vite build",
    "clean": "rm -rf lib demo/dist coverage",
    "format": "oxfmt .",
    "lint": "oxlint && oxfmt --check .",
    "prepublishOnly": "pnpm build",
    "start": "vite --open",
    "test": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.22.0"
}
